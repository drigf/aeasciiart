{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build + install plug-in (Release)",
      "type": "shell",
      "command": "make",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "xcodebuild",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "make debug",
      "group": "build",
      "problemMatcher": {
        "owner": "xcodebuild",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      }
    },
    {
      "label": "Regenerate Xcode project (after adding/removing files)",
      "type": "shell",
      "command": "make xcodeproj",
      "problemMatcher": []
    },
    {
      "label": "Open in Xcode",
      "type": "shell",
      "command": "open AsciiDepth.xcodeproj",
      "problemMatcher": []
    },
    {
      "label": "Render test images (no After Effects)",
      "type": "shell",
      "command": "make samples && open Tools/Harness/out",
      "problemMatcher": []
    }
  ]
}
